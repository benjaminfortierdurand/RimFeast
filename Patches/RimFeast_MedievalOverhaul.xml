<?xml version="1.0" encoding="utf-8" ?>
<Patch>

	<!-- avec MO, la faction cachée recrute ses figurants chez DankPyon -->
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Medieval Overhaul</li>
		</mods>
		<match Class="PatchOperationReplace">
			<xpath>Defs/FactionDef[defName="RimFeast_Guests"]/basicMemberKind</xpath>
			<value>
				<basicMemberKind>DankPyon_Medieval_Peasant</basicMemberKind>
			</value>
		</match>
	</Operation>

</Patch>
