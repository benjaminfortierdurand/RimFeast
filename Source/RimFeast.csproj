<Project Sdk="Microsoft.NET.Sdk">

	<!--
		Deux builds depuis le meme code, comme RimJoust :
		  dotnet build Source/RimFeast.csproj -c Release                     -> 1.7/Assemblies (par defaut)
		  dotnet build Source/RimFeast.csproj -c Release -p:GameVersion=1.6  -> 1.6/Assemblies
		La 1.7 tourne sur .NET 10 (plus de Unity) : SDK .NET 10, DLL du jeu installe.
		La 1.6 n'est plus installee : on compile contre le paquet NuGet Krafs.Rimworld.Ref 1.6.
	-->
	<PropertyGroup>
		<GameVersion Condition="'$(GameVersion)' == ''">1.7</GameVersion>
		<AssemblyName>RimFeast</AssemblyName>
		<RootNamespace>RimFeast</RootNamespace>
		<LangVersion>latest</LangVersion>
		<Nullable>disable</Nullable>

		<OutputPath>..\$(GameVersion)\Assemblies\</OutputPath>
		<IntermediateOutputPath>obj\$(Configuration)\$(GameVersion)\</IntermediateOutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<GenerateDependencyFile>false</GenerateDependencyFile>
		<DebugType>none</DebugType>
		<DebugSymbols>false</DebugSymbols>
	</PropertyGroup>

	<!-- Chemin du jeu installe. Edite si ton install est ailleurs. -->
	<PropertyGroup>
		<RimWorldDir>D:\Steam\steamapps\common\RimWorld</RimWorldDir>
		<Refs17Dir>D:\RimWorldMods\_refs\1.7</Refs17Dir>
		<HarmonyDir>D:\Steam\steamapps\workshop\content\294100\2009463077\$(GameVersion)\Assemblies</HarmonyDir>
	</PropertyGroup>

	<PropertyGroup Condition="'$(GameVersion)' == '1.6'">
		<TargetFramework>net48</TargetFramework>
	</PropertyGroup>

	<PropertyGroup Condition="'$(GameVersion)' == '1.7'">
		<TargetFramework>net10.0</TargetFramework>
	</PropertyGroup>

	<!-- RimWorld 1.6 + Unity : paquet de references NuGet -->
	<ItemGroup Condition="'$(GameVersion)' == '1.6'">
		<PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*-*" />
	</ItemGroup>

	<!-- RimWorld 1.7 : copie des DLL du jeu 1.7 dans _refs\1.7 (a recopier apres une MAJ de la beta) (runtime .NET 10, Unity remplace par UnityStubs) -->
	<ItemGroup Condition="'$(GameVersion)' == '1.7'">
		<Reference Include="$(Refs17Dir)\Assembly-CSharp.dll;$(Refs17Dir)\UnityStubs.dll;$(Refs17Dir)\Waylith.UnityCompat.dll;$(Refs17Dir)\Waylith.dll;$(Refs17Dir)\Brutal.Core.Logging.dll">
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<!-- Harmony : la DLL du mod Harmony installe, une par version du jeu. jamais copiee dans Assemblies -->
	<ItemGroup>
		<Reference Include="0Harmony">
			<HintPath>$(HarmonyDir)\0Harmony.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

</Project>
